<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="alpha.gui.MainWindow" spacing="12.0" prefWidth="760.0" prefHeight="600.0">
    <padding>
        <Insets top="18.0" right="18.0" bottom="16.0" left="18.0" />
    </padding>
    <children>
        <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="header-bar">
            <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                <Label text="Alpha" styleClass="title-label" />
                <Label text="A focused space for getting things done" styleClass="subtitle-label" />
            </VBox>
            <Label fx:id="taskCountLabel" styleClass="count-label" />
        </HBox>
        <Label text="Try: todo, deadline, event, list, find, mark, or delete"
               styleClass="hint-label" wrapText="true" />
        <ListView fx:id="taskListView" VBox.vgrow="ALWAYS">
            <placeholder>
                <Label text="No tasks yet. Add one using the command box below."
                       styleClass="empty-state-label" wrapText="true" />
            </placeholder>
        </ListView>
        <Label fx:id="feedbackLabel" minHeight="36.0" styleClass="feedback-label" wrapText="true" />
        <HBox spacing="8.0" styleClass="command-bar">
            <TextField fx:id="commandInput" promptText="Enter a command..." onAction="#handleCommand"
                       HBox.hgrow="ALWAYS" />
            <Button text="Run command" styleClass="run-button" onAction="#handleCommand" defaultButton="true" />
        </HBox>
    </children>
</VBox>
